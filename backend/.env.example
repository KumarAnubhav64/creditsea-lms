# ─── MongoDB ────────────────────────────────────────────────────────────
# Single-node replica set (docker-compose.yml handles rs.initiate).
# Transactions require replica set — standalone Mongo throws at runtime.
MONGO_URI=mongodb://localhost:27017/creditsea?replicaSet=rs0

# ─── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ─── JWT ────────────────────────────────────────────────────────────────
# Dev-only secret. Rotate before any public deployment.
JWT_SECRET=cs-dev-jwt-secret-change-me-in-prod
JWT_EXPIRES_IN=7d

# ─── Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ─── CORS ───────────────────────────────────────────────────────────────
# Comma-separated origins. Use * in dev, pin to domain in prod.
CORS_ORIGINS=*

# ─── Logging ────────────────────────────────────────────────────────────
# pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
